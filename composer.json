{
  "name": "youzspace/short-url",
  "description": "Pure PHP short URL generator with JSON storage",
  "type": "project",
  "require": {},
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^1.12",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "ShortUrl\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ShortUrl\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "analyse": "phpstan analyse app tests bootstrap.php --no-progress",
    "lint": "phpcs --standard=PSR12 app config tests bootstrap.php"
  }
}
